# REHEARSAL ONLY — DO NOT MERGE: hermes >= 1.10 understands CometBFT 0.38+ event encoding
# (compat_mode = '0.38'); the upstream image is Debian-based so we just add the tools the scripts use
FROM informalsystems/hermes:1.13.1

USER root
RUN apt-get update \
    && apt-get install -y iputils-ping ca-certificates bash vim curl jq \
    && rm -rf /var/lib/apt/lists/*

USER hermes
WORKDIR /home/hermes

# the upstream image sets ENTRYPOINT to the hermes binary
ENTRYPOINT []
CMD ["bash", "scripts/start-hermes.sh"]
